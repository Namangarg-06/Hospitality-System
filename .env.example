# ==================================================
# NG DineAI Environment Configuration
# ==================================================

# Project Metadata
PROJECT_NAME="NG DineAI"
VERSION="1.0.0"

# Application Security
SECRET_KEY=ng-dineai-luxury-secret-key-change-in-production-2026-secure
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Connection (Defaults to local SQLite for instant zero-friction setup; or PostgreSQL for production)
DATABASE_URL=sqlite:///./dineai.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql://dineai_user:dineai_secure_pass_2026@localhost:5432/dineai_db

# Artificial Intelligence Model Providers
# (Optional: If omitted, NG DineAI employs intelligent grounded heuristic simulation)
GEMINI_API_KEY=
OPENAI_API_KEY=
DEFAULT_AI_PROVIDER=gemini

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=15

# Frontend Vite Environment
VITE_API_URL=http://localhost:8000/api/v1
